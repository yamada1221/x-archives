{
  "manifest_version": 3,
  "name": "Xトラッカー ミュート画面取り込み",
  "version": "1.1.0",
  "minimum_chrome_version": "112",
  "description": "ミュート一覧の表示中の1画面を手動または24時間ごとに撮影します。実行できない場合は通知します。",
  "permissions": ["activeTab", "storage", "alarms", "notifications"],
  "icons": { "128": "icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "ミュート一覧を1画面取り込む" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://yamada1221.github.io/x-archives/*"],
    "js": ["bridge.js"],
    "run_at": "document_idle"
  }]
}
