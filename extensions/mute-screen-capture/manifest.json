{
  "manifest_version": 3,
  "name": "Xトラッカー ミュート画面取り込み",
  "version": "1.0.0",
  "minimum_chrome_version": "112",
  "description": "自分で開いたミュート一覧の表示中の1画面を、ボタンを押したときだけ撮影してXトラッカーに渡します。",
  "permissions": ["activeTab", "storage"],
  "action": { "default_popup": "popup.html", "default_title": "ミュート一覧を1画面取り込む" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://yamada1221.github.io/x-archives/*"],
    "js": ["bridge.js"],
    "run_at": "document_idle"
  }]
}
